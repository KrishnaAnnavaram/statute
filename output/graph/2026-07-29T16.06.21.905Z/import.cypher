MERGE (n:BusinessRule {rule_id: "BR-020"}) SET n.category = "CALCULATION", n.condition = "v_days_inactive := p_as_of_date - NVL(v_last_txn_date, p_as_of_date - 9999)", n.confidence = "high", n.line = 25, n.modality = "deontic", n.name = "Determine Days Inactive", n.needs_review = false, n.origin = "variable_derivation", n.signal_strength = 4, n.verification_method = "Test (exercise the code path)";
